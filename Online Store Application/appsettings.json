{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId={TraceId} SpanId={SpanId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "OnlineStoreApi",
    "ServiceVersion": "1.0.0",
    "Endpoint": "http://otel-collector:4317",
    "TraceSamplingRatio": 1.0,
    "IncludeEfCore": true,
    "IncludeRedis": true,
    "ExportTimeoutMs": 5000,
    "MaxBatchSize": 2048
  },
  "BackgroundJobs": {
    "QueueCapacity": 1000,
    "EnqueueTimeoutSeconds": 5,
    "MaxIdempotencyKeyLength": 256,
    "RetryQueueCapacity": 100,
    "RetryEnqueueTimeoutSeconds": 5,
    "RetryBaseDelaySeconds": 1,
    "RetryMaxDelaySeconds": 300,
    "MaxExecutionAttempts": 5,
    "MaxRequeueAttempts": 10,
    "JobTimeoutSeconds": 60
  },
  "InventorySettings": {
    "EnforceStock": true
  },
  "CommissionSettings": {
    "DefaultRate": 10
  },
  "StorageSettings": {
    "RootPath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "PaymentGatewaySettings": {
    "Provider": "Manual",
    "MerchantId": "",
    "CallbackUrl": "http://localhost:5173/payment/callback",
    "WebhookSecret": "dev-only-webhook-secret-change-in-production",
    "BaseUrl": "https://api.zarinpal.com",
    "EnableRealGateway": false
  },
  "AllowedHosts": "*"
}
