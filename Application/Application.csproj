<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- N14: decision for launch: stay on AutoMapper 14.0.0 and move to Mapperly after launch (fixed versions are commercial-only).
         Exactly these three advisories are suppressed, not advisories in general. Shared reason: AutoMapperDepthGuard caps
         self-referential maps at depth 64, request JSON is capped at MaxDepth 64, and no vulnerable pattern is reachable from external input. -->
    <!-- GHSA-rvv3-g6hj-g44x: StackOverflow on uncapped self-referential maps; covered by AutoMapperDepthGuard (MaxDepth 64). -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
    <!-- GHSA-gpwp-5797-mjff: vulnerable pattern not exposed (maps are static and internal, no user-controlled mapping input); plan: move to Mapperly after launch. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gpwp-5797-mjff" />
    <!-- GHSA-6vhm-j9h7-f9gh: vulnerable pattern not exposed (maps are static and internal, no user-controlled mapping input); plan: move to Mapperly after launch. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6vhm-j9h7-f9gh" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Common\Expressions\**" />
    <EmbeddedResource Remove="Common\Expressions\**" />
    <None Remove="Common\Expressions\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.34" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="AutoMapper" Version="14.0.0" />
  </ItemGroup>
  <PropertyGroup>
    <SsdtUnitTestVersion>3.1</SsdtUnitTestVersion>
  </PropertyGroup>
</Project>